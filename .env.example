# Ejemplo de variables de entorno para el proyecto

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=vehiculos_db
MYSQL_USER=root
MYSQL_PASSWORD=

# SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_DATABASE=vehiculos_db
